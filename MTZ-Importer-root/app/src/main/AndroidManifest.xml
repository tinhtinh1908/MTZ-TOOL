<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="root.dtinh.mtzimporter">
    <queries>
        <package android:name="com.android.thememanager"/>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_art"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_art"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="font/ttf"/>
                <data android:mimeType="font/otf"/>
                <data android:mimeType="application/x-font-ttf"/>
                <data android:mimeType="application/vnd.ms-opentype"/>
                <data android:pathPattern=".*\\.mtz"/>
                <data android:pathPattern=".*\\.ttf"/>
                <data android:pathPattern=".*\\.otf"/>
                <data android:pathPattern=".*\\.ttc"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
